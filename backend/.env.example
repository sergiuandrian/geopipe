APP_NAME=GeoPipe
DATABASE_URL=sqlite+aiosqlite:///./geopipe.db
SPATIAL_BACKEND=geopackage
# POSTGIS_URL=postgresql+psycopg://geopipe:geopipe@127.0.0.1:5432/geopipe
PUBLIC_BASE_URL=http://127.0.0.1:8000
MAX_UPLOAD_MB=50
FREE_REQUEST_LIMIT=10000
PRO_REQUEST_LIMIT=1000000
MCP_SERVER_NAME=geopipe
JWT_SECRET=geopipe-dev-secret-change-me
JWT_EXPIRE_HOURS=72
# Set true in production to disable anonymous bootstrap access
AUTH_REQUIRED=false
# Stripe (optional). Without these, use POST /v1/billing/dev-upgrade after login.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
STRIPE_SUCCESS_URL=http://localhost:5173/?billing=success
STRIPE_CANCEL_URL=http://localhost:5173/?billing=cancel
# On Vercel, DATA_DIR/UPLOAD_DIR default to /tmp/geopipe/{data,uploads}
# and PUBLIC_BASE_URL is derived from VERCEL_URL when unset.
